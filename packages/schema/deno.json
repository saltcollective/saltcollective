{
  "name": "@saltcollective/schema",
  "version": "0.0.1",
  "exports": "./src/index.ts",
  "imports": {
    "@prisma/client": "npm:@prisma/client@^6.0.0",
    "@prisma/extension-accelerate": "npm:@prisma/extension-accelerate@^1.0.0"
  },
  "tasks": {
    "db:generate": "deno run -A npm:prisma generate --no-engine",
    "db:push": "deno run -A npm:prisma db push",
    "db:migrate": "deno run -A npm:prisma migrate dev",
    "db:migrate:reset": "deno run -A npm:prisma migrate reset",
    "db:migrate:resolve": "deno run -A npm:prisma migrate resolve",
    "db:migrate:deploy": "deno run -A npm:prisma migrate deploy",
    "db:studio": "deno run -A npm:prisma studio"
  }
}
