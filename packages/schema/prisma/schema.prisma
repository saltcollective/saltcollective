generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("PRISMA_URL")
  directUrl = env("DATABASE_URL")
}

// Platform-level role. Club-scoped roles live on ClubMembership.
enum UserType {
  SITE_ADMIN
  MEMBER
}

enum ClubRole {
  ADMIN
  EDITOR
}

model User {
  id            String    @id @default(cuid())
  clerkId       String    @unique
  username      String?   @unique
  email         String    @unique
  userType      UserType  @default(MEMBER)
  isActive      Boolean   @default(true)
  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships    ClubMembership[]
  impersonations ImpersonationLog[] @relation("Impersonator")
  impersonatedBy ImpersonationLog[] @relation("Impersonated")
  discountCodes  DiscountCode[]     @relation("DiscountCodeCreator")
}

model ClubMembership {
  id        String   @id @default(cuid())
  userId    String
  clubId    String
  role      ClubRole
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  club Club @relation(fields: [clubId], references: [id])

  @@unique([userId, clubId])
}

model ImpersonationLog {
  id             String    @id @default(cuid())
  impersonatorId String
  impersonatedId String
  startedAt      DateTime  @default(now())
  endedAt        DateTime?

  impersonator User @relation("Impersonator", fields: [impersonatorId], references: [id])
  impersonated User @relation("Impersonated", fields: [impersonatedId], references: [id])
}

enum ClubStatus {
  ACTIVE
  SUSPENDED
}

enum ColorScheme {
  LIGHT
  DARK
  SYSTEM
}

model Club {
  id               String      @id @default(cuid())
  name             String
  slug             String      @unique
  tagline          String?
  logoUrl          String?
  primaryColour    String?
  secondaryColour  String?
  headingColour    String?
  backgroundColour String?
  colorScheme      ColorScheme @default(SYSTEM)
  status           ClubStatus  @default(ACTIVE)
  publishedAt      DateTime?
  stripeCustomerId String?    @unique
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  memberships   ClubMembership[]
  sponsorTiers  SponsorTier[]
  businesses    Business[]
  tags          Tag[]
  clickEvents   ClickEvent[]
  discountCode  DiscountCode?
  invites       ClubInvite[]
}

model SponsorTier {
  id        String   @id @default(cuid())
  clubId    String
  name      String
  order     Int
  price     Decimal? @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club       Club       @relation(fields: [clubId], references: [id])
  businesses Business[]

  @@unique([clubId, order])
}

model Business {
  id            String   @id @default(cuid())
  clubId        String
  sponsorTierId String
  name          String
  description   String
  logoUrl       String?
  phone         String?
  email         String?
  websiteUrl    String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  club        Club        @relation(fields: [clubId], references: [id])
  sponsorTier SponsorTier @relation(fields: [sponsorTierId], references: [id])
  tags        Tag[]
  clickEvents ClickEvent[]
}

model Tag {
  id        String   @id @default(cuid())
  clubId    String
  name      String
  createdAt DateTime @default(now())

  club       Club       @relation(fields: [clubId], references: [id])
  businesses Business[]

  @@unique([clubId, name])
}

enum ClickType {
  EMAIL
  WEBSITE
  PHONE
}

model ClickEvent {
  id         String    @id @default(cuid())
  businessId String
  clubId     String
  type       ClickType
  createdAt  DateTime  @default(now())

  business Business @relation(fields: [businessId], references: [id])
  club     Club     @relation(fields: [clubId], references: [id])
}

model DiscountCode {
  id               String    @id @default(cuid())
  code             String    @unique
  description      String?
  createdByUserId  String
  redeemedByClubId String?   @unique
  redeemedAt       DateTime?
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())

  createdBy  User  @relation("DiscountCodeCreator", fields: [createdByUserId], references: [id])
  redeemedBy Club? @relation(fields: [redeemedByClubId], references: [id])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model ClubInvite {
  id        String       @id @default(cuid())
  clubId    String
  email     String
  role      ClubRole     @default(EDITOR)
  token     String       @unique @default(cuid())
  status    InviteStatus @default(PENDING)
  createdAt DateTime     @default(now())
  expiresAt DateTime?

  club Club @relation(fields: [clubId], references: [id])

  @@unique([clubId, email])
}
