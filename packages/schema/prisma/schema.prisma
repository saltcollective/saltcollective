generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("PRISMA_URL")
  directUrl = env("DATABASE_URL")
}

// Platform-level role. Club-scoped roles live on ClubMembership.
enum UserType {
  SITE_ADMIN
  MEMBER
}

enum ClubRole {
  ADMIN
  EDITOR
}

model User {
  id            String    @id @default(cuid())
  clerkId       String    @unique
  username      String?   @unique
  email         String    @unique
  userType      UserType  @default(MEMBER)
  isActive      Boolean   @default(true)
  deactivatedAt DateTime?
  lastActiveAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships    ClubMembership[]
  impersonations ImpersonationLog[] @relation("Impersonator")
  discountCodes  DiscountCode[]     @relation("DiscountCodeCreator")
}

model ClubMembership {
  id        String   @id @default(cuid())
  userId    String
  clubId    String
  role      ClubRole
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  club Club @relation(fields: [clubId], references: [id])

  @@unique([userId, clubId])
}

enum AuditEntityType {
  CLUB
  USER
}

enum AuditEventType {
  CLUB_CREATED
  CLUB_PUBLISHED
  CLUB_SUSPENDED
  CLUB_REACTIVATED
  CLUB_DELETED
  USER_CREATED
  USER_DEACTIVATED
  USER_REACTIVATED
  USER_DELETED
  USER_TYPE_CHANGED
  MEMBER_JOINED
  MEMBER_REMOVED
  MEMBER_ROLE_CHANGED
  CLUB_IMPERSONATION_STARTED
  CLUB_IMPERSONATION_ENDED
}

// Append-only lifecycle audit log. Deliberately no FK relations: rows must
// survive hard-deletion of the club/user they describe, so ids are plain
// strings and entityName/actorEmail are point-in-time snapshots.
model AuditEvent {
  id         String          @id @default(cuid())
  entityType AuditEntityType
  entityId   String
  entityName String
  type       AuditEventType
  actorId    String?
  actorEmail String?
  detail     String?
  createdAt  DateTime        @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
}

// Club-targeted impersonation sessions. Club side is deliberately relation-free
// (plain id + name snapshot) so session history survives club deletion.
model ImpersonationLog {
  id             String    @id @default(cuid())
  impersonatorId String
  clubId         String
  clubName       String
  startedAt      DateTime  @default(now())
  endedAt        DateTime?

  impersonator User @relation("Impersonator", fields: [impersonatorId], references: [id])
}

enum ClubStatus {
  ACTIVE
  SUSPENDED
}

enum ColorScheme {
  LIGHT
  DARK
  SYSTEM
}

model Club {
  id               String      @id @default(cuid())
  name             String
  slug             String      @unique
  tagline          String?
  logoUrl          String?
  primaryColour    String?
  secondaryColour  String?
  headingColour    String?
  backgroundColour String?
  colorScheme      ColorScheme @default(SYSTEM)
  status           ClubStatus  @default(ACTIVE)
  publishedAt      DateTime?
  suspendedAt      DateTime?
  paidUntil        DateTime?
  stripeCustomerId String?    @unique
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  memberships   ClubMembership[]
  sponsorTiers  SponsorTier[]
  businesses    Business[]
  tags          Tag[]
  clickEvents   ClickEvent[]
  discountCode  DiscountCode?
  invites       ClubInvite[]
}

model SponsorTier {
  id        String   @id @default(cuid())
  clubId    String
  name      String
  order     Int
  price     Decimal? @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club       Club       @relation(fields: [clubId], references: [id])
  businesses Business[]

  @@unique([clubId, order])
}

enum BusinessStatus {
  LEAD // submitted via sponsor request, awaiting admin action
  ACTIVE // live on the hub
  DECLINED // admin declined the lead
  ARCHIVED // previously active, removed from the hub
}

model Business {
  id            String         @id @default(cuid())
  clubId        String
  sponsorTierId String? // nullable: a lead has a *desired* tier, which may be unset
  name          String
  description   String? // nullable: a lead may not provide a description up front
  logoUrl       String?
  phone         String?
  email         String?
  websiteUrl    String?
  status            BusinessStatus @default(ACTIVE)
  contactName       String? // person who submitted a sponsor request
  confirmationPhone String? // private follow-up number for the club to call (not the public business phone)
  desiredSpend      Decimal?       @db.Decimal(10, 2)
  message           String? // free-text note from a sponsor request
  source            String? // e.g. "sponsor-request" vs admin-created
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  club        Club         @relation(fields: [clubId], references: [id])
  sponsorTier SponsorTier? @relation(fields: [sponsorTierId], references: [id])
  tags        Tag[]
  clickEvents ClickEvent[]
}

model Tag {
  id        String   @id @default(cuid())
  clubId    String
  name      String
  createdAt DateTime @default(now())

  club       Club       @relation(fields: [clubId], references: [id])
  businesses Business[]

  @@unique([clubId, name])
}

enum ClickType {
  EMAIL
  WEBSITE
  PHONE
}

model ClickEvent {
  id         String    @id @default(cuid())
  businessId String
  clubId     String
  type       ClickType
  createdAt  DateTime  @default(now())

  business Business @relation(fields: [businessId], references: [id])
  club     Club     @relation(fields: [clubId], references: [id])
}

model DiscountCode {
  id               String    @id @default(cuid())
  code             String    @unique
  description      String?
  createdByUserId  String
  redeemedByClubId String?   @unique
  redeemedAt       DateTime?
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())

  createdBy  User  @relation("DiscountCodeCreator", fields: [createdByUserId], references: [id])
  redeemedBy Club? @relation(fields: [redeemedByClubId], references: [id])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model ClubInvite {
  id        String       @id @default(cuid())
  clubId    String
  email     String
  role      ClubRole     @default(EDITOR)
  token     String       @unique @default(cuid())
  status    InviteStatus @default(PENDING)
  createdAt DateTime     @default(now())
  expiresAt DateTime?

  club Club @relation(fields: [clubId], references: [id])

  @@unique([clubId, email])
}
